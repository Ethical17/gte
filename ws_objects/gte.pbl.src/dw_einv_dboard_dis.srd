 retrieve="select EEL_ID, EEL_UNIT_ID, EEL_DOCNUM, EEL_DATE, EEL_RESPONSE
 from  ltc.fb_einv_error_log 
 where nvl(EEL_UNIT_ID,'HO') = decode(nvl(EEL_UNIT_ID,'HO'),:ra_unit_id,nvl(EEL_UNIT_ID,'HO')) and trunc(EEL_DATE) between to_date(:ra_frdt,'dd/mm/yyyy') and to_date(:ra_todt,'dd/mm/yyyy')" update="ltc.fb_einv_error_log" updatewhere=1 updatekeyinplace=no arguments=(("ra_unit_id", string),("ra_frdt", string),("ra_todt", string))  sort="eel_id D eel_date D " )
