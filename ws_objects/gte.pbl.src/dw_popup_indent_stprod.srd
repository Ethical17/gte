table(column=(type=char(20) updatewhereclause=yes name=po_id dbname="fb_purorder.po_id" dbalias="a.po_id" )
 column=(type=char(10) updatewhereclause=yes name=sp_id dbname="fb_purorderdetails.sp_id" dbalias="b.sp_id" )
 column=(type=char(200) updatewhereclause=yes name=sp_name dbname="sp_name" )
 column=(type=char(10) updatewhereclause=yes name=sp_unit dbname="fb_storeproduct.sp_unit" dbalias="c.sp_unit" )
 column=(type=char(30) updatewhereclause=yes name=indent_id dbname="fb_purorder.indent_id" dbalias="a.indent_id" )
 column=(type=number updatewhereclause=yes name=bal dbname="bal" )
 column=(type=decimal(6) updatewhereclause=yes name=unit_price dbname="fb_purorderdetails.unit_price" dbalias="b.unit_price" )
 column=(type=decimal(2) updatewhereclause=yes name=discountper dbname="fb_purorderdetails.discountper" dbalias="b.discountper" )
 column=(type=number updatewhereclause=yes name=eff_unit_price dbname="eff_unit_price" )
 column=(type=number updatewhereclause=yes name=total dbname="total" )
 retrieve="select a.po_id,b.SP_ID, decode(nvl(c.SSP_ID,'x'),'x',SP_NAME,d.SSP_NAME)SP_NAME ,c.SP_UNIT ,a.indent_id,((nvl(POD_QUANTITY,0) + (nvl(POD_QUANTITY,0) *nvl(SP_TOLLER_PER,0)/100))  - (nvl(po_recv_qty,0)+nvl(po_cancel_qty,0))) bal,
       POD_UNITPRICE unit_price, POD_DISCOUNTPER discountper,POD_UNITPRICE - (POD_UNITPRICE*(POD_DISCOUNTPER/100)) eff_unit_price,(POD_UNITPRICE - (POD_UNITPRICE*(POD_DISCOUNTPER/100))) *  ((nvl(POD_QUANTITY,0) + (nvl(POD_QUANTITY,0) *nvl(SP_TOLLER_PER,0)/100))  - (nvl(po_recv_qty,0)+nvl(po_cancel_qty,0))) total
 from fb_purorder a ,fb_purorderdetails b ,fb_storeproduct c , fb_storeproduct_std d 
 where a.po_id=b.po_id and b.sp_id=c.sp_id and c.SSP_ID=d.ssp_id(+) and
        ((nvl(POD_QUANTITY,0) + (nvl(POD_QUANTITY,0) *nvl(SP_TOLLER_PER,0)/100))  - (nvl(po_recv_qty,0)+nvl(po_cancel_qty,0)))>0"  sort="sp_name A sp_unit A " )
