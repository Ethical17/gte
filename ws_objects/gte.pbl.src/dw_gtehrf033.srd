 column=(type=char(1) updatewhereclause=yes name=appr_ind dbname="appr_ind" values="Approve	Y/Approve	N" )
 column=(type=char(1) updatewhereclause=yes name=del_ind dbname="del_ind" values="Reject	Y/Reject	N" )
 retrieve="select rowid,EMP_ID, EP_PROMOTION_DT, EMP_TYPE_OLD, EMP_TYPE_NEW, EMP_GRADE_OLD, EMP_GRADE_NEW,EBS_BASICAMOUNT_old,EBS_BASICAMOUNT_new, EP_ENTRY_DT, EP_ENTRY_BY, EP_APPROVE_BY, EP_APPROVE_DT,ep_remarks
		,'N' appr_ind,'N' del_ind 
from fb_emp_promotion 
where   ((:ra_appr = 'N' and EP_APPROVE_DT is not null ) or (:ra_appr = 'Y'  and EP_APPROVE_DT is null ))" update="fb_emp_promotion" updatewhere=0 updatekeyinplace=yes arguments=(("ra_appr", string),("ra_user_level", string)) )
