table(column=(type=char(37) updatewhereclause=yes key=yes name=rowid dbname="fb_emp_promotion.rowid" )
 column=(type=char(25) update=yes updatewhereclause=yes name=emp_id dbname="fb_emp_promotion.emp_id" )
 column=(type=datetime update=yes updatewhereclause=yes name=ep_promotion_dt dbname="fb_emp_promotion.ep_promotion_dt" )
 column=(type=char(3) update=yes updatewhereclause=yes name=emp_type_old dbname="fb_emp_promotion.emp_type_old" values="Executive	EXE/Staff	ST/Sub Staff	SS/Apprentice	AT/" )
 column=(type=char(3) update=yes updatewhereclause=yes name=emp_type_new dbname="fb_emp_promotion.emp_type_new" values="Executive	EXE/Staff	ST/Sub Staff	SS/Apprentice	AT/" )
 column=(type=char(30) update=yes updatewhereclause=yes name=emp_grade_old dbname="fb_emp_promotion.emp_grade_old" )
 column=(type=char(30) update=yes updatewhereclause=yes name=emp_grade_new dbname="fb_emp_promotion.emp_grade_new" )
