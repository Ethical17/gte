 retrieve="SELECT initcap(decode(f.KAMSUB_ID,'ESUB0057','SICK','ESUB0058','maternity','ESUB0056','Wages For Holidays','ESUB0061','Leave With Wages','ESUB0258','ABSENT','ESUB0260','ABSENT','ESUB0259','ABSENT','AT WORK')) KAM,
decode(decode(f.KAMSUB_ID,'ESUB0057','SICK','ESUB0058','maternity','ESUB0056','Wages For Holidays','ESUB0061','Leave With Wages','ESUB0258','ABSENT','ESUB0260','ABSENT','ESUB0259','ABSENT','AT WORK'),'AT WORK',1,'maternity',2,'SICK',3,'wages For Holidays',4,'Leave With Wages',5,'Wages For Holidays',6,7
) sl,
       sum(decode(sign(b.TASK_DATE - to_date(:ra_frdt,'dd/mm/yyyy')),-1,0,decode(sign(b.TASK_DATE - to_date(:ra_todt,'dd/mm/yyyy')),1,0,(nvl(b.TASK_PMATODAYTY,0))))) Pmaletoday,
       sum(decode(sign(b.TASK_DATE - to_date(:ra_frdt,'dd/mm/yyyy')),-1,0,decode(sign(b.TASK_DATE - to_date(:ra_todt,'dd/mm/yyyy')),1,0,(nvl(b.TASK_PFATODAYTY,0))))) Pfemaletoday,
       sum(decode(sign(b.TASK_DATE - to_date(:ra_frdt,'dd/mm/yyyy')),-1,0,decode(sign(b.TASK_DATE - to_date(:ra_todt,'dd/mm/yyyy')),1,0,(nvl(b.TASK_TMATODAYTY,0))))) Tmaletoday,
       sum(decode(sign(b.TASK_DATE - to_date(:ra_frdt,'dd/mm/yyyy')),-1,0,decode(sign(b.TASK_DATE - to_date(:ra_todt,'dd/mm/yyyy')),1,0,(nvl(b.TASK_TFATODAYTY,0))))) Tfemaletoday,       
       sum(decode(sign(b.TASK_DATE - to_date(:ra_ysdt,'dd/mm/yyyy')),-1,0,decode(sign(b.TASK_DATE - to_date(:ra_todt,'dd/mm/yyyy')),1,0,(nvl(b.TASK_PMATODAYTY,0))))) Pmaletodate,       
       sum(decode(sign(b.TASK_DATE - to_date(:ra_ysdt,'dd/mm/yyyy')),-1,0,decode(sign(b.TASK_DATE - to_date(:ra_todt,'dd/mm/yyyy')),1,0,(nvl(b.TASK_PFATODAYTY,0))))) Pfemaletodate, 
       sum(decode(sign(b.TASK_DATE - to_date(:ra_ysdt,'dd/mm/yyyy')),-1,0,decode(sign(b.TASK_DATE - to_date(:ra_todt,'dd/mm/yyyy')),1,0,(nvl(b.TASK_TMATODAYTY,0))))) Tmaletodate,        
       sum(decode(sign(b.TASK_DATE - to_date(:ra_ysdt,'dd/mm/yyyy')),-1,0,decode(sign(b.TASK_DATE - to_date(:ra_todt,'dd/mm/yyyy')),1,0,(nvl(b.TASK_TFATODAYTY,0))))) Tfemaletodate,        
       sum(decode(sign(b.TASK_DATE - to_date(:ra_ly_frdt,'dd/mm/yyyy')),-1,0,decode(sign(b.TASK_DATE - to_date(:ra_ly_todt,'dd/mm/yyyy')),1,0,(nvl(b.TASK_PMATODAYTY,0))))) Pmalelytoday,
       sum(decode(sign(b.TASK_DATE - to_date(:ra_ly_frdt,'dd/mm/yyyy')),-1,0,decode(sign(b.TASK_DATE - to_date(:ra_ly_todt,'dd/mm/yyyy')),1,0,(nvl(b.TASK_PFATODAYTY,0) ) ))) Pfemalelytoday, 
       sum(decode(sign(b.TASK_DATE - to_date(:ra_ly_ysdt,'dd/mm/yyyy')),-1,0,decode(sign(b.TASK_DATE - to_date(:ra_ly_todt,'dd/mm/yyyy')),1,0,(nvl(b.TASK_PMATODAYTY,0)) ))) Pmalelytodate,        
       sum(decode(sign(b.TASK_DATE - to_date(:ra_ly_ysdt,'dd/mm/yyyy')),-1,0,decode(sign(b.TASK_DATE - to_date(:ra_ly_todt,'dd/mm/yyyy')),1,0,(nvl(b.TASK_PFATODAYTY,0))))) Pfemalelytodate,       
       sum(decode(sign(b.TASK_DATE - to_date(:ra_ly_frdt,'dd/mm/yyyy')),-1,0,decode(sign(b.TASK_DATE - to_date(:ra_ly_todt,'dd/mm/yyyy')),1,0,(nvl(b.TASK_TMATODAYTY,0))))) Tmalelytoday, 
       sum(decode(sign(b.TASK_DATE - to_date(:ra_ly_ysdt,'dd/mm/yyyy')),-1,0,decode(sign(b.TASK_DATE - to_date(:ra_ly_todt,'dd/mm/yyyy')),1,0,(nvl(b.TASK_TMATODAYTY,0)) ))) Tmalelytodate,
       sum(decode(sign(b.TASK_DATE - to_date(:ra_ly_frdt,'dd/mm/yyyy')),-1,0,decode(sign(b.TASK_DATE - to_date(:ra_ly_todt,'dd/mm/yyyy')),1,0,(nvl(b.TASK_TFATODAYTY,0) ) ))) Tfemalelytoday, 
       sum(decode(sign(b.TASK_DATE - to_date(:ra_ly_ysdt,'dd/mm/yyyy')),-1,0,decode(sign(b.TASK_DATE - to_date(:ra_ly_todt,'dd/mm/yyyy')),1,0,(nvl(b.TASK_TFATODAYTY,0))))) Tfemalelytodate
 FROM    FB_TASKACTIVEDAILY b, FB_ACSUBLEDGER c, FB_EXPENSEACSUBHEAD e, FB_KAMSUBHEAD f , fb_section g, FB_ACLEDGER h, fb_field i
 WHERE  c.ACSUBLEDGER_ID = e.EACHEAD_ID AND  e.EACSUBHEAD_ID = f.KAMSUB_ID AND b.SECTION_ID = g.SECTION_ID(+) and g.field_id = i.field_id(+) and
                c.ACLEDGER_ID = h.ACLEDGER_ID and g.FIELD_ID = decode(:ra_field,'ALL',g.FIELD_ID,:ra_field) and nvl(KAMSUB_ACTIVE_IND,'N') = 'Y' and
            b.TASK_ID = f.KAMSUB_ID AND --f.KAMSUB_NKAMTYPE not in ('ABSENT' ,'HOLIDAYNOPAY' ,'SICKNOWAGES') AND 
            (trunc(b.TASK_DATE) between to_date(:ra_ysdt,'dd/mm/yyyy') AND to_date(:ra_todt,'dd/mm/yyyy') or
             trunc(b.TASK_DATE) between to_date(:ra_ly_ysdt,'dd/mm/yyyy') AND to_date(:ra_ly_todt,'dd/mm/yyyy') ) 
group by   initcap(decode(f.KAMSUB_ID,'ESUB0057','SICK','ESUB0058','maternity','ESUB0056','Wages For Holidays','ESUB0061','Leave With Wages','ESUB0258','ABSENT','ESUB0260','ABSENT','ESUB0259','ABSENT','AT WORK')),
decode(decode(f.KAMSUB_ID,'ESUB0057','SICK','ESUB0058','maternity','ESUB0056','Wages For Holidays','ESUB0061','Leave With Wages','ESUB0258','ABSENT','ESUB0260','ABSENT','ESUB0259','ABSENT','AT WORK'),'AT WORK',1,'maternity',2,'SICK',3,'wages For Holidays',4,'Leave With Wages',5,'Wages For Holidays',6,7)
