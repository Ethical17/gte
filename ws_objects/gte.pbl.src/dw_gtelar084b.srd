table(column=(type=datetime updatewhereclause=yes name=lma_date dbname="lma_date" )
 column=(type=char(30) updatewhereclause=yes name=division dbname="division" )
 column=(type=char(10) updatewhereclause=yes name=section_id dbname="section_id" )
 column=(type=char(80) updatewhereclause=yes name=section_name dbname="section_name" )
 column=(type=number updatewhereclause=yes name=total_qty dbname="total_qty" )
 column=(type=number updatewhereclause=yes name=mandays dbname="mandays" )
 column=(type=number updatewhereclause=yes name=division_total dbname="division_total" )
 column=(type=number updatewhereclause=yes name=grand_total dbname="grand_total" )
 column=(type=number updatewhereclause=yes name=avg_qty_per_worker dbname="avg_qty_per_worker" )
 column=(type=number updatewhereclause=yes name=section_contribution_pct dbname="section_contribution_pct" )
 column=(type=number updatewhereclause=yes name=division_contribution_pct dbname="division_contribution_pct" )
 column=(type=number updatewhereclause=yes name=section_rank dbname="section_rank" )
 column=(type=number updatewhereclause=yes name=labour_share_pct dbname="labour_share_pct" )
 column=(type=number updatewhereclause=yes name=productivity_rank dbname="productivity_rank" )
 retrieve="SELECT lma_date,division,section_id,section_name,total_qty,mandays,
    SUM(total_qty) OVER (PARTITION BY lma_date, division) AS division_total,SUM(total_qty) OVER (PARTITION BY lma_date) AS grand_total,
    ROUND(total_qty / NULLIF(mandays,0),2) avg_qty_per_worker,ROUND((total_qty / SUM(total_qty) OVER (PARTITION BY lma_date, division)) * 100,2) section_contribution_pct,
ROUND((SUM(total_qty) OVER (PARTITION BY lma_date, division) /SUM(total_qty) OVER (PARTITION BY lma_date)) * 100,2) division_contribution_pct,
RANK() OVER(PARTITION BY lma_date, division ORDER BY total_qty DESC ) section_rank,
ROUND(mandays / SUM(mandays) OVER (PARTITION BY lma_date, division)*100,2) labour_share_pct,
RANK() OVER (PARTITION BY lma_date ORDER BY (total_qty / NULLIF(mandays,0)) DESC ) productivity_rank
FROM
(
    SELECT 
        lma_date,
        division,
        section_id,
        section_name,
        SUM(qty) AS total_qty,
        COUNT(DISTINCT workerid) AS mandays
    FROM
    (
        SELECT 
            a.lma_date,
            INITCAP(h.field_name) AS division,
            a.lma_sectionid1 AS section_id,
            INITCAP(e.section_name) AS section_name,
            a.lma_workerid AS workerid,
            NVL(a.lma_ntwt1,0) AS qty
        FROM fb_mobile_attendance a
        LEFT JOIN fb_section e 
               ON a.lma_sectionid1 = e.section_id
        LEFT JOIN fb_field h 
               ON e.field_id = h.field_id
        WHERE NVL(a.lma_ntwt1,0) > 0
        UNION ALL
        SELECT 
            a.lma_date,
            INITCAP(i.field_name) AS division,
            a.lma_sectionid2 AS section_id,
            INITCAP(f.section_name) AS section_name,
            a.lma_workerid AS workerid,
            NVL(a.lma_ntwt2,0) AS qty
        FROM fb_mobile_attendance a
        LEFT JOIN fb_section f 
               ON a.lma_sectionid2 = f.section_id
        LEFT JOIN fb_field i 
               ON f.field_id = i.field_id
        WHERE NVL(a.lma_ntwt2,0) > 0
        UNION ALL
        SELECT 
            a.lma_date,
            INITCAP(j.field_name) AS division,
            a.lma_sectionid3 AS section_id,
            INITCAP(g.section_name) AS section_name,
            a.lma_workerid AS workerid,
            NVL(a.lma_ntwt3,0) AS qty
        FROM fb_mobile_attendance a
        LEFT JOIN fb_section g 
               ON a.lma_sectionid3 = g.section_id
        LEFT JOIN fb_field j 
               ON g.field_id = j.field_id
        WHERE NVL(a.lma_ntwt3,0) > 0
    )
    WHERE lma_date = TO_DATE(:ra_date,'dd/mm/yyyy')
    GROUP BY 
        lma_date,
        division,
        section_id,
        section_name
)
ORDER BY division, section_name" arguments=(("ra_date", string),("ra_eff_per", string))  sort="lma_date A division A " )
