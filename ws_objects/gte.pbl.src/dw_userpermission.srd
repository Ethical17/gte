table(column=(type=char(1) updatewhereclause=yes name=users dbname="users" )
 column=(type=char(20) updatewhereclause=yes name=fb_module_master_module dbname="fb_module_master.module" dbalias="fmm.module" )
 column=(type=char(20) updatewhereclause=yes name=fb_screen_detail_screen_type dbname="fb_screen_detail.screen_type" dbalias="fsd.screen_type" )
 column=(type=char(50) updatewhereclause=yes name=fb_screen_detail_screen_code dbname="fb_screen_detail.screen_code" dbalias="fsd.screen_code" )
 column=(type=number updatewhereclause=yes name=screentype_sorting dbname="screentype_sorting" )
 column=(type=char(255) updatewhereclause=yes name=fb_screen_detail_menu_path dbname="fb_screen_detail.menu_path" dbalias="fsd.menu_path" )
 column=(type=number updatewhereclause=yes name=permission dbname="permission" )
 retrieve="SELECT 
    TO_CHAR(:ra_user_id) AS USERS,
    fmm.MOD_NAME AS MODULE,
    fsd.SD_TYPE_NAME AS SCREEN_TYPE,
    fsd.SD_SCREEN AS SCREEN_CODE,
    case when fsd.SD_TYPE_NAME ='MODULE' then 1 when fsd.SD_TYPE_NAME ='MASTER' then 2 when fsd.SD_TYPE_NAME ='TRANSACTION' then 3 when fsd.SD_TYPE_NAME ='REPORT' then 4 end screentype_sorting,
    fsd.SD_MENU_DETAIL AS MENU_PATH,
    NVL(fld.LD_PERMISSION,0) AS PERMISSION
FROM ltc.fb_screen_detail fsd
LEFT OUTER JOIN fb_module_master fmm ON TO_CHAR(fmm.ID) = TRIM(fsd.SD_MODULE)
LEFT OUTER JOIN
(SELECT USER_ID,LD_SCREEN,LD_PERMISSION FROM fb_login fl INNER JOIN fb_login_detail fld ON user_id = ld_user_id WHERE user_id = :ra_user_id) fld ON fld.ld_screen = fsd.SD_SCREEN
order by 1,2,5" arguments=(("ra_user_id", string))  sort="users A fb_module_master_module A fb_screen_detail_screen_code A " )
