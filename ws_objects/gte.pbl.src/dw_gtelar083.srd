 retrieve="select case when ADD_MONTHS(EMP_DOB, 12 * 58)>trunc(sysdate) then 'To be retire on -'|| ADD_MONTHS(EMP_DOB, 12 * 58) else 'Retire on -' || ADD_MONTHS(EMP_DOB, 12 * 58) end type ,EMP_ID, EMP_NAME, EMP_TYPE
from fb_employee a, (select UNIT_NAME from fb_gardenmaster where unit_active_ind='Y') 
where nvl(EMP_ACTIVE,'0')='1' and EMP_TYPE<>'LT' and get_diff(TRUNC(sysdate), TRUNC(EMP_DOB-90), 'B')>58
" update="fb_employee" updatewhere=0 updatekeyinplace=no  sort="type A " )
