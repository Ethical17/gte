table(column=(type=datetime updatewhereclause=yes name=fb_mobile_attendance_lma_date dbname="fb_mobile_attendance.lma_date" )
 column=(type=char(30) updatewhereclause=yes name=fb_field_wt1_division dbname="wt1_division" )
 column=(type=char(10) updatewhereclause=yes name=fb_mobile_attendance_wt1_sectionid dbname="fb_mobile_attendance.wt1_sectionid" )
 column=(type=char(30) updatewhereclause=yes name=fb_section_wt1_sectionname dbname="wt1_sectionname" )
 column=(type=number updatewhereclause=yes name=wt1_nt_wt dbname="wt1_nt_wt" )
 column=(type=number updatewhereclause=yes name=wt1_mndy dbname="wt1_mndy" )
 column=(type=char(30) updatewhereclause=yes name=fb_field_wt2_division dbname="wt2_division" )
 column=(type=char(10) updatewhereclause=yes name=fb_mobile_attendance_wt2_sectionid dbname="fb_mobile_attendance.wt2_sectionid" )
 column=(type=char(30) updatewhereclause=yes name=fb_section_wt2_sectionname dbname="wt2_sectionname" )
 column=(type=number updatewhereclause=yes name=wt2_nt_wt dbname="wt2_nt_wt" )
 column=(type=number updatewhereclause=yes name=wt2_mndy dbname="wt2_mndy" )
 column=(type=char(30) updatewhereclause=yes name=fb_field_wt3_division dbname="wt3_division" )
 column=(type=char(10) updatewhereclause=yes name=fb_mobile_attendance_wt3_sectionid dbname="fb_mobile_attendance.wt3_sectionid" )
 column=(type=char(30) updatewhereclause=yes name=fb_section_wt3_sectionname dbname="wt3_sectionname" )
 column=(type=number updatewhereclause=yes name=wt3_nt_wt dbname="wt3_nt_wt" )
 column=(type=number updatewhereclause=yes name=wt3_mndy dbname="wt3_mndy" )
 column=(type=number updatewhereclause=yes name=lma_ntwtt dbname="lma_ntwtt" )
 retrieve="select lma_date, 
       INITCAP(h.FIELD_NAME) wt1_division,LMA_SECTIONID1 wt1_sectionid,INITCAP(e.SECTION_NAME) wt1_sectionname, sum(LMA_NTWT1) wt1_nt_wt,(count(case when nvl(LMA_NTWT1,0) > 0 then LMA_WORKERID end)) wt1_mndy,
      INITCAP(i.FIELD_NAME) wt2_division,LMA_SECTIONID2 wt2_sectionid,INITCAP(e.SECTION_NAME) wt2_sectionname, sum(LMA_NTWT2) wt2_nt_wt,(count(case when nvl(LMA_NTWT2,0) > 0 then LMA_WORKERID end)) wt2_mndy,
       INITCAP(j.FIELD_NAME) wt3_division,LMA_SECTIONID3 wt3_sectionid,INITCAP(g.SECTION_NAME) wt3_sectionname, sum(LMA_NTWT3) wt3_nt_wt,(count(case when nvl(LMA_NTWT3,0) > 0 then LMA_WORKERID end)) wt3_mndy,
       sum(LMA_NTWTT) LMA_NTWTT
from fb_mobile_attendance a
inner join fb_employee b on a.LMA_WORKERID=b.emp_id
inner join FB_EXPENSEACSUBHEAD c on a.lma_kamsubheadid=c.EACSUBHEAD_ID
inner join fb_laboursheet d on b.LS_ID=d.LS_ID
left outer join fb_section e on a.lma_sectionid1=e.SECTION_ID
left outer join fb_section f on a.lma_sectionid2=f.SECTION_ID
left outer join fb_section g on a.lma_sectionid3=g.SECTION_ID
left outer join fb_field h on e.FIELD_ID=h.FIELD_ID
left outer join fb_field i on f.FIELD_ID=i.FIELD_ID
left outer join fb_field j on g.FIELD_ID=j.FIELD_ID
where lma_date =to_date(:ra_date,'dd/mm/yyyy') and nvl(lma_ntwtt,0) > 0
group by lma_date,h.FIELD_NAME ,LMA_SECTIONID1 ,e.SECTION_NAME,i.FIELD_NAME ,LMA_SECTIONID2,f.SECTION_NAME,j.FIELD_NAME,LMA_SECTIONID3,g.SECTION_NAME" arguments=(("ra_date", string),("ra_eff_per", string))  sort="fb_mobile_attendance_lma_date A fb_field_wt1_division A " )
