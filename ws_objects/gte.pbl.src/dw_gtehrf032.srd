table(column=(type=char(37) updatewhereclause=yes key=yes name=rowid dbname="fb_empattendance_log.rowid" dbalias=".rowid" )
 column=(type=char(25) update=yes updatewhereclause=yes name=emp_id dbname="fb_empattendance_log.emp_id" dbalias=".emp_id" )
 column=(type=datetime update=yes updatewhereclause=yes name=eattenl_date dbname="fb_empattendance_log.eattenl_date" dbalias=".eattenl_date" )
 column=(type=char(10) update=yes updatewhereclause=yes name=eattenl_old_status dbname="fb_empattendance_log.eattenl_old_status" dbalias=".eattenl_old_status" values="Working	WK/Absent	AB/Casual	CL/Sick	SI/Sick Out	SO/Earned	EL/Suspend	SP/Maternity	MA/Weekoff	WR/Holiday	HD/HWPay	HW/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=eattenl_old_hajari dbname="fb_empattendance_log.eattenl_old_hajari" dbalias=".eattenl_old_hajari" values="Full	F/Half	H/3//4	T/1//4	O/" )
 column=(type=char(10) update=yes updatewhereclause=yes name=eattenl_new_status dbname="fb_empattendance_log.eattenl_new_status" dbalias=".eattenl_new_status" values="Working	WK/Absent	AB/Casual	CL/Sick	SI/Sick Out	SO/Earned	EL/Suspend	SP/Maternity	MA/Weekoff	WR/Holiday	HD/HWPay	HW/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=eattenl_new_hajari dbname="fb_empattendance_log.eattenl_new_hajari" dbalias=".eattenl_new_hajari" values="Full	F/Half	H/3//4	T/1//4	O/" )
