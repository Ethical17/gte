 retrieve="select rowid,EMP_ID, EATTENL_DATE, EATTENL_OLD_STATUS, EATTENL_OLD_HAJARI, EATTENL_NEW_STATUS, EATTENL_NEW_HAJARI, FIELD_ID, EATTENL_REASON, 
        EATTENL_ENTRY_BY, EATTENL_ENTRY_DT, EATTENL_APPROVE_BY, EATTENL_APPROVE_DT ,'N' appr_ind,'N' del_ind
from FB_EMPATTENDANCE_log 
