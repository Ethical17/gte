table(column=(type=datetime updatewhereclause=yes name=lma_date dbname="lma_date" )
 column=(type=char(8) updatewhereclause=yes name=lma_workerid dbname="lma_workerid" )
 column=(type=char(30) updatewhereclause=yes name=emp_name dbname="emp_name" )
 column=(type=decimal(0) updatewhereclause=yes name=ls_id dbname="ls_id" )
 column=(type=decimal(2) updatewhereclause=yes name=lma_ntwtt dbname="lma_ntwtt" )
 column=(type=char(30) updatewhereclause=yes name=wt1_sectionname dbname="wt1_sectionname" )
 column=(type=decimal(2) updatewhereclause=yes name=wt1_nt_wt dbname="wt1_nt_wt" )
 column=(type=number updatewhereclause=yes name=wt1_sec_nt_wt dbname="wt1_sec_nt_wt" )
 column=(type=number updatewhereclause=yes name=wt1_sec_avg_nt_wt dbname="wt1_sec_avg_nt_wt" )
 column=(type=char(30) updatewhereclause=yes name=wt2_sectionname dbname="wt2_sectionname" )
 column=(type=decimal(2) updatewhereclause=yes name=wt2_nt_wt dbname="wt2_nt_wt" )
 column=(type=number updatewhereclause=yes name=wt2_sec_nt_wt dbname="wt2_sec_nt_wt" )
 column=(type=number updatewhereclause=yes name=wt2_sec_avg_nt_wt dbname="wt2_sec_avg_nt_wt" )
 column=(type=char(30) updatewhereclause=yes name=wt3_sectionname dbname="wt3_sectionname" )
 column=(type=decimal(2) updatewhereclause=yes name=wt3_nt_wt dbname="wt3_nt_wt" )
 column=(type=number updatewhereclause=yes name=wt3_sec_nt_wt dbname="wt3_sec_nt_wt" )
 column=(type=number updatewhereclause=yes name=wt3_sec_avg_nt_wt dbname="wt3_sec_avg_nt_wt" )
 column=(type=number updatewhereclause=yes name=lab_effiency dbname="lab_effiency" )
 column=(type=number updatewhereclause=yes name=totalnet dbname="totalnet" )
 retrieve="select LMA_DATE ,LMA_WORKERID, initcap(EMP_NAME) EMP_NAME ,LS_ID,LMA_NTWTT,
       initcap(wt1_sectionname) wt1_sectionname,wt1_nt_wt,wt1_sec_nt_wt,wt1_sec_avg_nt_wt,
       initcap(wt2_sectionname) wt2_sectionname,wt2_nt_wt,wt2_sec_nt_wt,wt2_sec_avg_nt_wt,
       initcap(wt3_sectionname) wt3_sectionname,wt3_nt_wt,wt3_sec_nt_wt,wt3_sec_avg_nt_wt,
       round(lab_eff_per,0) lab_effiency,totalnet
from 
(
select LMA_DATE, LMA_WORKERID,EMP_NAME, b.LS_ID,LS_MANID, LMA_KAMSUBHEADID,EACSUBHEAD_NAME, LMA_NTWTT, LMA_PST_IND, LMA_STATUS,
       LMA_TIME1 wt1_time, h.FIELD_NAME wt1_division,LMA_SECTIONID1 wt1_sectionid,e.SECTION_NAME wt1_sectionname, LMA_NTWT1 wt1_nt_wt,
       sum(nvl(LMA_NTWT1,0)) over (partition by LMA_DATE,LMA_SECTIONID1 order by  LMA_DATE, LMA_SECTIONID1) wt1_sec_nt_wt,
       count(case when nvl(LMA_NTWT1,0) > 0 then LMA_WORKERID end) over (partition by LMA_DATE,LMA_SECTIONID1) wt1_mndy,      
       round((sum(nvl(LMA_NTWT1,0)) over (partition by LMA_DATE,LMA_SECTIONID1 order by  LMA_DATE, LMA_SECTIONID1) / decode(count(case when nvl(LMA_NTWT1,0) > 0 then LMA_WORKERID end) over (partition by LMA_DATE,LMA_SECTIONID1),0,1,count(case when nvl(LMA_NTWT1,0) > 0 then LMA_WORKERID end) over (partition by LMA_DATE,LMA_SECTIONID1))),0) wt1_sec_avg_nt_wt, 
       LMA_TIME2 wt2_time, i.FIELD_NAME wt2_division,LMA_SECTIONID2 wt2_sectionid,f.SECTION_NAME wt2_sectionname, LMA_NTWT2 wt2_nt_wt, 
       sum(nvl(LMA_NTWT2,0)) over (partition by LMA_DATE,LMA_SECTIONID2 order by  LMA_DATE, LMA_SECTIONID2) wt2_sec_nt_wt,
       count(case when nvl(LMA_NTWT2,0) > 0 then LMA_WORKERID end) over (partition by LMA_DATE,LMA_SECTIONID2) wt2_mndy,
       round((sum(nvl(LMA_NTWT2,0)) over (partition by LMA_DATE,LMA_SECTIONID2 order by  LMA_DATE, LMA_SECTIONID2) / decode(count(case when nvl(LMA_NTWT2,0) > 0 then LMA_WORKERID end) over (partition by LMA_DATE,LMA_SECTIONID2),0,1,count(case when nvl(LMA_NTWT2,0) > 0 then LMA_WORKERID end) over (partition by LMA_DATE,LMA_SECTIONID2))),0) wt2_sec_avg_nt_wt, 
       LMA_TIME3 wt3_time, j.FIELD_NAME wt3_division,LMA_SECTIONID3 wt3_sectionid,g.SECTION_NAME wt3_sectionname,  LMA_NTWT3 wt3_nt_wt ,
       sum(nvl(LMA_NTWT3,0)) over (partition by LMA_DATE,LMA_SECTIONID3 order by  LMA_DATE, LMA_SECTIONID3) wt3_sec_nt_wt,
       count(case when nvl(LMA_NTWT3,0) > 0 then LMA_WORKERID end) over (partition by LMA_DATE,LMA_SECTIONID3) wt3_mndy,
       round((sum(nvl(LMA_NTWT3,0)) over (partition by LMA_DATE,LMA_SECTIONID3 order by  LMA_DATE, LMA_SECTIONID3) / decode(count(case when nvl(LMA_NTWT3,0) > 0 then LMA_WORKERID end) over (partition by LMA_DATE,LMA_SECTIONID3),0,1,count(case when nvl(LMA_NTWT3,0) > 0 then LMA_WORKERID end) over (partition by LMA_DATE,LMA_SECTIONID3))),0) wt3_sec_avg_nt_wt ,
       sum(LMA_NTWTT) over (partition by LMA_DATE order by LMA_DATE) totalnet,
       (LMA_NTWTT / (round((sum(nvl(LMA_NTWT1,0)) over (partition by LMA_DATE,LMA_SECTIONID1 order by  LMA_DATE, LMA_SECTIONID1) / decode(count(case when nvl(LMA_NTWT1,0) > 0 then LMA_WORKERID end) over (partition by LMA_DATE,LMA_SECTIONID1),0,1,count(case when nvl(LMA_NTWT1,0) > 0 then LMA_WORKERID end) over (partition by LMA_DATE,LMA_SECTIONID1))),0) +
       round((sum(nvl(LMA_NTWT2,0)) over (partition by LMA_DATE,LMA_SECTIONID2 order by  LMA_DATE, LMA_SECTIONID2) / decode(count(case when nvl(LMA_NTWT2,0) > 0 then LMA_WORKERID end) over (partition by LMA_DATE,LMA_SECTIONID2),0,1,count(case when nvl(LMA_NTWT2,0) > 0 then LMA_WORKERID end) over (partition by LMA_DATE,LMA_SECTIONID2))),0) +
       round((sum(nvl(LMA_NTWT3,0)) over (partition by LMA_DATE,LMA_SECTIONID3 order by  LMA_DATE, LMA_SECTIONID3) / decode(count(case when nvl(LMA_NTWT3,0) > 0 then LMA_WORKERID end) over (partition by LMA_DATE,LMA_SECTIONID3),0,1,count(case when nvl(LMA_NTWT3,0) > 0 then LMA_WORKERID end) over (partition by LMA_DATE,LMA_SECTIONID3))),0)) * 100) lab_eff_per
from fb_mobile_attendance a
inner join fb_employee b on a.LMA_WORKERID=b.emp_id
inner join FB_EXPENSEACSUBHEAD c on a.lma_kamsubheadid=c.EACSUBHEAD_ID
inner join fb_laboursheet d on b.LS_ID=d.LS_ID
left outer join fb_section e on a.lma_sectionid1=e.SECTION_ID
left outer join fb_section f on a.lma_sectionid2=f.SECTION_ID
left outer join fb_section g on a.lma_sectionid3=g.SECTION_ID
left outer join fb_field h on e.FIELD_ID=h.FIELD_ID
left outer join fb_field i on f.FIELD_ID=i.FIELD_ID
left outer join fb_field j on g.FIELD_ID=j.FIELD_ID
where lma_date =to_date(:ra_date,'dd/mm/yyyy') and nvl(lma_ntwtt,0) > 0
) 
where round(lab_eff_per,0) <= decode(:ra_eff_per,0,round(lab_eff_per,0),:ra_eff_per)
order by round(lab_eff_per,0) asc  
" arguments=(("ra_date", string),("ra_eff_per", string))  sort="lab_effiency A " )
