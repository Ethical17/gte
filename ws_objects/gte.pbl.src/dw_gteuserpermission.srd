table(column=(type=char(1) updatewhereclause=yes name=users dbname="users" )
 column=(type=char(20) updatewhereclause=yes name=fb_module_master_module dbname="fb_module_master.module" )
 column=(type=char(20) updatewhereclause=yes name=fb_screen_detail_screen_type dbname="fb_screen_detail.screen_type" )
 column=(type=char(50) updatewhereclause=yes name=fb_screen_detail_screen_code dbname="fb_screen_detail.screen_code" )
 column=(type=char(255) updatewhereclause=yes name=fb_screen_detail_menu_path dbname="fb_screen_detail.menu_path" )
 column=(type=number updatewhereclause=yes name=permission dbname="permission" values="Admin	1/User	2/Inquiry	3/No Permission	0/" )
 column=(type=number updatewhereclause=yes name=org_permission dbname="org_permission" )
 column=(type=char(1) updatewhereclause=yes name=master_check dbname="master_check" values="	Y/	N" )
 column=(type=char(20) update=yes updatewhereclause=yes name=ld_user_id dbname="fb_login_detail.ld_user_id" )
 column=(type=char(10) update=yes updatewhereclause=yes name=ld_apps dbname="fb_login_detail.ld_apps" )
 column=(type=char(50) update=yes updatewhereclause=yes name=ld_module dbname="fb_login_detail.ld_module" )
 column=(type=char(25) update=yes updatewhereclause=yes name=ld_screen dbname="fb_login_detail.ld_screen" )
 column=(type=char(255) update=yes updatewhereclause=yes name=ld_menu_detail dbname="fb_login_detail.ld_menu_detail" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=ld_permission dbname="fb_login_detail.ld_permission" )
 column=(type=char(37) updatewhereclause=yes key=yes name=rowid dbname="fb_login_detail.rowid" )
 retrieve="SELECT 
    TO_CHAR(:ra_user_id) AS USERS,
    fmm.MOD_NAME AS MODULE,
    fsd.SD_TYPE_NAME AS SCREEN_TYPE,
    fsd.SD_SCREEN AS SCREEN_CODE,
    fsd.SD_MENU_DETAIL AS MENU_PATH,
    NVL(fld.LD_PERMISSION,0) AS PERMISSION,
   NVL(fld.LD_PERMISSION,0) AS ORG_PERMISSION,
    'N' AS MASTER_CHECK,
    LD_USER_ID, LD_APPS, LD_MODULE, LD_SCREEN, LD_MENU_DETAIL,LD_PERMISSION,fld.rowid
FROM ltc.fb_screen_detail fsd
LEFT OUTER JOIN fb_module_master fmm ON TO_CHAR(fmm.ID) = TRIM(fsd.SD_MODULE)
LEFT OUTER JOIN fb_login_detail fld on fld.ld_screen = fsd.SD_SCREEN and ld_user_id=:ra_user_id
WHERE (:ra_permission = -1 OR NVL(fld.LD_PERMISSION,0) = :ra_permission)" update="fb_login_detail" updatewhere=0 updatekeyinplace=yes arguments=(("ra_user_id", string),("ra_permission", number))  sort="fb_module_master_module A fb_screen_detail_screen_type A " )
