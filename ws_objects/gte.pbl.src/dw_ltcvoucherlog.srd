table(column=(type=char(20) updatewhereclause=yes name=vh_vou_no dbname="fb_vou_head_cncl.vh_vou_no" dbalias="a.vh_vou_no" )
 column=(type=datetime updatewhereclause=yes name=vh_vou_date dbname="fb_vou_head_cncl.vh_vou_date" dbalias="a.vh_vou_date" )
 column=(type=datetime updatewhereclause=yes name=vh_entry_dt dbname="fb_vou_head_cncl.vh_entry_dt" dbalias="a.vh_entry_dt" )
 column=(type=char(25) updatewhereclause=yes name=vh_entry_by dbname="fb_vou_head_cncl.vh_entry_by" dbalias="a.vh_entry_by" )
 column=(type=char(25) updatewhereclause=yes name=vh_approved_by dbname="fb_vou_head_cncl.vh_approved_by" dbalias="a.vh_approved_by" )
 column=(type=char(25) updatewhereclause=yes name=vh_cncl_by dbname="fb_vou_head_cncl.vh_cncl_by" dbalias="a.vh_cncl_by" )
 column=(type=datetime updatewhereclause=yes name=vh_cncl_dt dbname="fb_vou_head_cncl.vh_cncl_dt" dbalias="a.vh_cncl_dt" )
 column=(type=char(100) updatewhereclause=yes name=vh_cncl_reason dbname="fb_vou_head_cncl.vh_cncl_reason" dbalias="a.vh_cncl_reason" )
 column=(type=char(25) updatewhereclause=yes name=vd_gl_cd dbname="fb_vou_det_cncl.vd_gl_cd" dbalias="b.vd_gl_cd" )
 column=(type=char(50) updatewhereclause=yes name=acledger_manid dbname="fb_acledger.acledger_manid" dbalias="d.acledger_manid" )
 column=(type=char(25) updatewhereclause=yes name=vd_sgl_cd dbname="fb_vou_det_cncl.vd_sgl_cd" dbalias="b.vd_sgl_cd" )
 column=(type=char(75) updatewhereclause=yes name=acsubledger_manid dbname="fb_acsubledger.acsubledger_manid" dbalias="c.acsubledger_manid" )
 column=(type=decimal(2) updatewhereclause=yes name=vd_amount dbname="fb_vou_det_cncl.vd_amount" dbalias="b.vd_amount" )
 column=(type=char(1) updatewhereclause=yes name=fb_vou_det_cncl_vd_dc_ind dbname="fb_vou_det_cncl.vd_dc_ind" dbalias="b.vd_dc_ind" )
 retrieve="select VH_VOU_NO, VH_VOU_DATE, VH_ENTRY_DT, VH_ENTRY_BY, VH_APPROVED_BY, VH_CNCL_BY, VH_CNCL_DT, VH_CNCL_REASON ,VD_GL_CD ,ACLEDGER_MANID, VD_SGL_CD,
			ACSUBLEDGER_MANID,VD_AMOUNT, VD_DC_IND
from fb_vou_head_cncl a ,fb_vou_det_cncl b ,fb_acsubledger c, fb_acledger d 
where a.vh_doc_srl=b.VD_DOC_SRL and VD_GL_CD=d.ACLEDGER_ID and VD_SGL_CD=ACSUBLEDGER_ID
and trunc(vh_vou_date) between to_date(:ra_frdt,'dd/mm/yyyy') and to_date(:ra_todat,'dd/mm/yyyy')
order by 2,1" arguments=(("ra_frdt", string),("ra_todat", string)) )
